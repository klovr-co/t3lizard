# systemd user unit for the xstack-cloud daemon (formerly t3lizard).
# Install (not done by the build):
#   cp systemd/xstack-cloud.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now xstack-cloud
# Edit the paths below to match this machine first, and put your Infisical project id in
# ~/.t3lizard/systemd.env as INFISICAL_PROJECT_ID=<id> (kept out of this public file).
[Unit]
Description=xstack-cloud: pool of cloud machines (InstaBox or Lizard) running T3 Code
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Node 24 runs the .ts sources directly. Use an absolute node path; nvm is not on PATH under systemd.
EnvironmentFile=%h/.t3lizard/systemd.env
ExecStart=/usr/bin/infisical run --projectId ${INFISICAL_PROJECT_ID} --env prod --silent -- %h/.nvm/versions/node/v24.21.0/bin/node %h/t3lizard/bin/xstack-cloud daemon
WorkingDirectory=%h/t3lizard
Environment=PATH=%h/.nvm/versions/node/v24.21.0/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# The local T3 Code CLI. Set it to the output of `which t3`.
Environment=T3LIZARD_T3_CLI=%h/.local/bin/t3
Restart=always
RestartSec=5
# The daemon reopens proxies from state on start, so a restart keeps T3 links working.
KillSignal=SIGTERM
TimeoutStopSec=20
UMask=0077

[Install]
WantedBy=default.target
